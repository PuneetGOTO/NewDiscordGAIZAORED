msgstr "AFK 频道：{afk_chan}\n"
"AFK 超时：{afk_timeout}\n"
"自定义表情：{emoji_count}\n"
"角色：{role_count}"

#: redbot/cogs/general/general.py:412
msgid "Not set"
msgstr "未设置"

#: redbot/cogs/general/general.py:450
msgid "Server features:"
msgstr "服务器特性："

#: redbot/cogs/general/general.py:450
msgid "Server features (continued):"
msgstr "服务器特性（续）："

#: redbot/cogs/general/general.py:455
msgid "Tier {boostlevel} with {nitroboosters} boosts\n"
"File size limit: {filelimit}\n"
"Emoji limit: {emojis_limit}\n"
"VCs max bitrate: {bitrate}"
msgstr "等级 {boostlevel}，{nitroboosters} 个 boost\n"
"文件大小限制：{filelimit}\n"
"表情限制：{emojis_limit}\n"
"语音频道最大比特率：{bitrate}"

