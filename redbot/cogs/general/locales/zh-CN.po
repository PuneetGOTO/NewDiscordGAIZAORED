"🔊 Voice: {voice}\n"
"🎙 Stage: {stage}"
msgstr "💬 文字：{text}\n"
"🔊 语音：{voice}\n"
"🎙 舞台：{stage}"

#: redbot/cogs/general/general.py:394
msgid "Utility:"
msgstr "实用信息："

#: redbot/cogs/general/general.py:395
msgid "Owner: {owner}\n"
"Verif. level: {verif}\n"
"Server ID: {id}{shard_info}"
msgstr "所有者：{owner}\n"
"验证级别：{verif}\n"
"服务器 ID：{id}{shard_info}"

#: redbot/cogs/general/general.py:406
